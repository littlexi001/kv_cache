+        cache_chunk = probs[:, :, :, :past_len].sum(dim=-2)
+        attn_cache += _reduce_group_scores(cache_chunk, groups, gqa_score_agg)
+        del scores, probs, cache_chunk
+    return attn_cache.to(query_states.dtype)

+def _h2o_attn_cache_chunked(query_states, key_states, window_size, gqa_score_agg='mean'):
+    # Exact H2O accumulated attention cache without materializing [H, Q, K].
+    bsz, num_query_heads, q_len, head_dim = query_states.shape
+    past_len = q_len - window_size
+    if past_len <= 0:
+        return key_states.new_empty((bsz, key_states.shape[1], 0))
+
+    groups = _gqa_groups(query_states, key_states)
+    key_rep = repeat_kv(key_states, groups)
+    num_kv_heads = key_states.shape[1]
+    attn_cache = torch.zeros((bsz, num_kv_heads, past_len), dtype=torch.float32, device=query_states.device)
+    chunk_q = int(os.environ.get('KVCF_H2O_CHUNK_Q', '64'))
+    chunk_q = max(1, chunk_q)
+    k_pos = torch.arange(q_len, device=query_states.device)
+
+    for start in range(0, q_len, chunk_q):
+        end = min(q_len, start + chunk_q)
+        q_chunk = query_states[:, :, start:end, :]
+        scores = torch.matmul(q_chunk, key_rep.transpose(2, 3)) / math.sqrt(head_dim)
+        q_pos = torch.arange(start, end, device=query_states.device)
+        scores = scores.masked_fill(k_pos.view(1, 1, 1, q_len) > q_pos.view(1, 1, end - start, 1), torch.finfo(scores.dtype).min)

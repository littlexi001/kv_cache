+def _sdpa_output_from_flat_per_head(query_states, key_states, value_states, head_lens, num_heads, head_dim):
+    # SDPA fallback for AdaKV's flattened per-head variable-length cache.
+    bsz, _, q_len, _ = query_states.shape
+    assert bsz == 1, 'AdaKV SDPA fallback currently supports batch_size=1'
+    num_cached_heads = int(head_lens.shape[0])
+    kv_groups = num_heads // num_cached_heads
+    outputs = []
+    offset = 0
+    for head_idx in range(num_cached_heads):
+        cur_len = int(head_lens[head_idx].item())
+        k = key_states[offset:offset + cur_len].view(1, 1, cur_len, head_dim)
+        v = value_states[offset:offset + cur_len].view(1, 1, cur_len, head_dim)
+        q = query_states[:, head_idx * kv_groups:(head_idx + 1) * kv_groups, :, :]
+        k = k.expand(bsz, kv_groups, cur_len, head_dim).contiguous()
+        v = v.expand(bsz, kv_groups, cur_len, head_dim).contiguous()
+        outputs.append(torch.nn.functional.scaled_dot_product_attention(
+            q.contiguous(), k, v, attn_mask=None, dropout_p=0.0, is_causal=False
+        ))
+        offset += cur_len
+    return torch.cat(outputs, dim=1)
+

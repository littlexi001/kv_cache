# Input paths
MODEL_ROOT=/mnt/workspace/Qwen3-0.6B
DCLM_ROOT=/mnt/workspace/dclm
RUN_ROOT=/mnt/workspace/pe_pretrain_100b_iclr27

# Set this independently in every interactive instance.
GPU_LIST=0

# Matched 100B-token pretraining protocol across every trainable condition.
# INITIALIZATION=from_scratch reads the Qwen config/tokenizer but not its weights.
INITIALIZATION=from_scratch
SEQ_LEN=8192
MICRO_BATCH=1
GRAD_ACCUM=32
GLOBAL_BATCH_SIZE=256
TARGET_TOKENS=100000000000
MILESTONE_TOKENS=100000000,1000000000,10000000000,25000000000,50000000000,75000000000,100000000000
TOTAL_STEPS=47684
MILESTONES=48,477,4769,11921,23842,35763,47684
LEARNING_RATE=1e-4
WARMUP_STEPS=500
WEIGHT_DECAY=0.1
ADAM_BETA1=0.9
ADAM_BETA2=0.95
ADAM_EPSILON=1e-8
SEED=20260808
DATA_SEED=1701
NUM_WORKERS=2

# DCLM manifest. Files are sampled deterministically across all shard folders.
TRAIN_FILES=200000
VALIDATION_FILES=1024

# Evaluation budget. LongBench is an official dataset subset; the controlled
# RULER probe is self-contained and is not an official leaderboard score.
EVAL_LENGTHS=2048,4096,8192
RULER_SAMPLES_PER_TASK=4
PPL_BLOCKS=16
RUN_LONGBENCH=1
LONGBENCH_TASKS=hotpotqa,2wikimqa,multifieldqa_en
LONGBENCH_SAMPLES_PER_TASK=8
MAX_NEW_TOKENS=32

# Runtime. SDPA is portable; set flash_attention_2 only when already installed.
ATTN_IMPLEMENTATION=sdpa
DTYPE=bfloat16
PYTHON_BIN=python
HF_ENDPOINT=https://hf-mirror.com
TOKENIZERS_PARALLELISM=false

# TensorBoard is written by Trainer and started automatically by each worker.
LOGGING_STEPS=5
TENSORBOARD_ENABLED=1
TENSORBOARD_HOST=0.0.0.0
TENSORBOARD_PORT=6006
